rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && (
        request.auth.uid == uid ||
        // Another user may bump ONLY this user's friendsCount, and only once a
        // friendship between the two of them already exists (created in the
        // same accept-request flow, just before this update runs).
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friendsCount']) &&
          (
            exists(/databases/$(database)/documents/friendships/$(uid + '_' + request.auth.uid)) ||
            exists(/databases/$(database)/documents/friendships/$(request.auth.uid + '_' + uid))
          )
        )
      );
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if signedIn(); // reaction/reply counters — any signed-in user may bump these
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;

      match /replies/{replyId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
      }
    }

    match /friend_requests/{requestId} {
      allow read: if signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid;
      allow delete: if signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    match /friendships/{friendshipId} {
      allow read: if signedIn() && request.auth.uid in resource.data.users;
      allow create: if signedIn() && request.auth.uid in request.resource.data.users;
      allow delete: if signedIn() && request.auth.uid in resource.data.users;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      // Created by any signed-in user (e.g. the sender of a message or
      // mention) on behalf of the recipient — there's no other party who
      // could write it, since the actor isn't the recipient.
      allow create: if signedIn();
      allow update: if signedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /communities/{communityId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn() && request.auth.uid in request.resource.data.memberIds && request.resource.data.ownerId == request.auth.uid;
      // Anyone already a member may add or remove any other member —
      // deliberately no admin-only restriction, per how this was requested.
      allow update: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /messages/{messageId} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/communities/$(communityId)).data.memberIds;
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/communities/$(communityId)).data.memberIds
          && request.resource.data.senderId == request.auth.uid;
      }
    }

    match /conversations/{conversationId} {
      // getOrCreateConversation() checks existence with getDoc() before creating —
      // resource is null for a conversation that doesn't exist yet, so the get
      // must be allowed in that case too, or the existence check itself is denied.
      allow get: if signedIn() && (resource == null || request.auth.uid in resource.data.participantIds);
      allow list: if signedIn();
      allow update: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participantIds;

      match /messages/{messageId} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
          && request.resource.data.senderId == request.auth.uid;
      }
    }
  }
}
